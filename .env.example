# ---------------------------------------------------------------------------
# Aries configuration. Copy this file to ".env" and fill in your values.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Your Anthropic API key. Required for Aries' reasoning/chat.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# The Claude model Aries uses. Leave the default unless you have a reason.
ARIES_MODEL=claude-sonnet-4-5

# Max tokens Aries may generate per reply.
ARIES_MAX_TOKENS=4096

# Host / port the local server binds to.
# 127.0.0.1 keeps Aries private to this machine (recommended).
# Use 0.0.0.0 only if you deliberately want family devices on your LAN to reach it.
ARIES_HOST=127.0.0.1
ARIES_PORT=8787

# Where the local database lives (relative paths are resolved from the repo root).
ARIES_DB_PATH=data/aries.db

# Integrity phrase. Aries prepends this to genuine security/offline alerts so
# your family can verify an urgent notice really came from Aries. Change it to
# something only your household knows.
ARIES_INTEGRITY_PHRASE=The stars hold steady.

# How many days of raw conversation logs to keep before pruning (per the spec).
ARIES_CHATLOG_RETENTION_DAYS=7

# ---------------------------------------------------------------------------
# Family authentication
# ---------------------------------------------------------------------------
# When true, the web UI requires each household member to log in. On first run
# you set the Principal's password from the setup screen; the Principal can then
# add family members (each with their own password). Set to false only for a
# throwaway/single-user local start with no login.
ARIES_REQUIRE_AUTH=true

# How long a login session stays valid (hours). Default 14 days.
ARIES_SESSION_TTL_HOURS=336

# ---------------------------------------------------------------------------
# Google integration (Gmail + Calendar) — read + propose
# ---------------------------------------------------------------------------
# Aries reads your calendar/inbox for awareness and briefings. Writing to your
# calendar or sending email always requires your explicit confirmation.
#
# Setup (one time):
#   1. Go to https://console.cloud.google.com/ and create a project.
#   2. APIs & Services -> enable "Google Calendar API" and "Gmail API".
#   3. Configure the OAuth consent screen (External; add yourself as a test user).
#   4. Credentials -> Create Credentials -> OAuth client ID -> Web application.
#   5. Add this Authorized redirect URI EXACTLY:
#        http://127.0.0.1:8787/api/integrations/google/callback
#      (match host/port to ARIES_HOST/ARIES_PORT; if you set ARIES_PUBLIC_BASE_URL,
#       use that base instead.)
#   6. Paste the client ID and secret below (or download the JSON to
#      data/google_credentials.json and leave these blank).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: path to a downloaded OAuth client JSON instead of the two vars above.
GOOGLE_CREDENTIALS_FILE=data/google_credentials.json

# Where the connected account's token is stored (created after you connect).
GOOGLE_TOKEN_FILE=data/google_token.json

# Only needed if you reach Aries at a non-default base URL (e.g. a LAN hostname).
# Must match the redirect URI registered in Google Cloud.
# ARIES_PUBLIC_BASE_URL=http://127.0.0.1:8787
